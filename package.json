{
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.4.3"
  },
  "description": "A free, self-hosted family calendar — month and agenda views, per-person colors, holidays, and a free-time finder.",
  "devDependencies": {
    "@tailwindcss/cli": "4.1.13",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  },
  "license": "MIT",
  "name": "family-calendar",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "bun ./client/build.mjs",
    "dev": "bun --watch ./server/src/index.ts",
    "seed": "bun ./server/src/seed.ts",
    "start": "bun ./server/src/index.ts",
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json"
  },
  "type": "module",
  "version": "1.0.0"
}